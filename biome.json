{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!ai-kit",
      "!broken",
      "!public/broken",
      "!.next",
      "!node_modules",
      "!coverage",
      "!test-results",
      "!playwright-report",
      "!next-env.d.ts",
      "!data/measure.json",
      "!app/fonts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": { "preset": "none" },
      "suspicious": { "noExplicitAny": "error", "noTsIgnore": "error" }
    }
  },
  "css": { "parser": { "cssModules": false } }
}
